# ---- Yellowstone gRPC (the stream layer) ----
# Fill these once you have a provider endpoint (SolInfra credits, QuickNode/Shyft trial, etc.)
# Any Yellowstone-compatible endpoint works (Triton, Helius LaserStream, Shyft, QuickNode, dRPC...).
GRPC_URL=
GRPC_TOKEN=

# ---- Solana RPC (reads + sending the non-bundle fallback) ----
# Free Helius/QuickNode/public mainnet RPC is fine here.
RPC_URL=https://api.mainnet-beta.solana.com

# ---- Jito ----
# Block engine: mainnet only (Jito does NOT work on devnet). Regional variants:
#   amsterdam / frankfurt / ny / tokyo .mainnet.block-engine.jito.wtf
JITO_BLOCK_ENGINE=https://mainnet.block-engine.jito.wtf
JITO_TIP_FLOOR_URL=https://bundles.jito.wtf/api/v1/bundles/tip_floor

# ---- Your funded mainnet signer ----
# A base58-encoded secret key for a THROWAWAY wallet. Fund with ~0.05-0.1 SOL.
# Never commit a real .env. Keep this out of git.
SIGNER_SECRET_KEY=

# ---- AI agent (optional) ----
# If set, the agent reasons via the GitHub Models API. If unset, it uses the deterministic
# fallback (still produces real decisions + counterfactuals, just no LLM).
GITHUB_MODELS_API_KEY=
GITHUB_MODEL=gpt-4o
